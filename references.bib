@Article{Ismail2015,
  author   = {Ismail, A. F. and Padaki, M. and Hilal, N. and Matsuura, T. and Lau, W. J.},
  journal  = {Desalination},
  title    = {Thin film composite membrane — Recent development and future potential},
  year     = {2015},
  issn     = {0011-9164},
  pages    = {140–148},
  volume   = {356},
  abstract = {This paper provides a review on the recent development of thin film composite (TFC) membrane, which has received increasing attention in the field of water desalination process. The development of new thin films and substrates, and the effect of additives are mostly focused in this review. In particular, nanotechnology has shown its impact on the development of TFC membranes by incorporating nanoparticles and nanofibers in the substrate as well as in the top thin film. The search for novel monomers and novel fabrication methods of thin film, modification of substrate, and optimization of operational conditions is also the topic of this review article. It still remains a challenge to produce high impact TFC membranes with antifouling and biofouling properties, chemical resistance, improved mechanical strength and thermal stability. For this purpose, further insights into the phase inversion and interfacial polymerization processes are necessary. Currently, it seems that there is no end in the near future for the further development of TFC membranes, which will be followed by the expansion of the scope of their applications in various chemical and biochemical industrial sectors.},
  doi      = {https://doi.org/10.1016/j.desal.2014.10.042},
  groups   = {Not used yet},
  keywords = {Thin film Substrate Nanocomposite Productivity Interfacial polymerization},
  type     = {Journal Article},
  url      = {https://www.sciencedirect.com/science/article/pii/S0011916414005761},
}

